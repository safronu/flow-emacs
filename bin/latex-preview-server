#!/data/data/com.termux/files/usr/bin/env python3
"""latex-preview-server — auto-refreshing HTTP preview for latex-scratch.

Run in a Termux tab alongside emacs:

    latex-preview-server            # binds 127.0.0.1:8765
    latex-preview-server -p 9000    # custom port

Then open http://localhost:8765/ in the Boox browser (pin it in split-screen
next to Termux).  The page reloads whenever ~/latex-scratch/preview/latest.png
changes on disk, so every <f5> in emacs shows up here within a second.
"""

import argparse
import mimetypes
import os
import pathlib
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = pathlib.Path.home() / "latex-scratch" / "preview"
LATEST = ROOT / "latest.png"

PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>LaTeX preview</title>
<style>
  html,body{margin:0;padding:0;background:#fff;color:#000;
    font-family:sans-serif;height:100%%;}
  #wrap{display:flex;flex-direction:column;height:100%%;}
  header{padding:6px 10px;border-bottom:1px solid #ccc;font-size:14px;
    display:flex;justify-content:space-between;align-items:center;}
  #img-wrap{flex:1;display:flex;align-items:center;justify-content:center;
    overflow:auto;padding:12px;}
  img{max-width:100%%;max-height:100%%;object-fit:contain;}
  code{background:#f0f0f0;padding:1px 4px;border-radius:3px;}
</style></head>
<body><div id="wrap">
  <header>
    <span>LaTeX preview &middot; <span id="stamp">-</span></span>
    <span>reload every <code>%(interval)s</code>s</span>
  </header>
  <div id="img-wrap"><img id="img" alt="no preview yet — hit &lt;f5&gt; in emacs"></div>
</div>
<script>
const IMG   = document.getElementById('img');
const STAMP = document.getElementById('stamp');
let lastMTime = 0;
async function tick(){
  try{
    const r = await fetch('/mtime', {cache:'no-store'});
    const j = await r.json();
    if(j.mtime && j.mtime !== lastMTime){
      lastMTime = j.mtime;
      IMG.src = '/latest.png?t=' + j.mtime;
      STAMP.textContent = new Date(j.mtime*1000).toLocaleTimeString();
    }
  }catch(e){ /* server not ready */ }
}
setInterval(tick, %(interval_ms)s);
tick();
</script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    interval = 1.0

    def log_message(self, fmt, *args):
        pass  # keep the terminal quiet

    def do_GET(self):  # noqa: N802
        if self.path == "/" or self.path.startswith("/index"):
            body = (PAGE % {
                "interval": self.interval,
                "interval_ms": int(self.interval * 1000),
            }).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
            return

        if self.path == "/mtime":
            mtime = int(LATEST.stat().st_mtime) if LATEST.exists() else 0
            body = ('{"mtime":%d}' % mtime).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        # Serve any file under ROOT (latest.png, latest.tex, previous frames).
        name = self.path.lstrip("/").split("?", 1)[0]
        target = (ROOT / name).resolve()
        try:
            target.relative_to(ROOT.resolve())
        except ValueError:
            self.send_error(403)
            return
        if not target.is_file():
            self.send_error(404)
            return
        ctype, _ = mimetypes.guess_type(target.name)
        self.send_response(200)
        self.send_header("Content-Type", ctype or "application/octet-stream")
        self.send_header("Content-Length", str(target.stat().st_size))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        with target.open("rb") as fh:
            self.wfile.write(fh.read())


def main() -> int:
    ap = argparse.ArgumentParser(description="Auto-refresh HTTP preview for latex-scratch")
    ap.add_argument("-b", "--bind", default="127.0.0.1")
    ap.add_argument("-p", "--port", type=int, default=8765)
    ap.add_argument("-i", "--interval", type=float, default=1.0,
                    help="browser poll interval in seconds (default 1.0)")
    args = ap.parse_args()

    ROOT.mkdir(parents=True, exist_ok=True)
    Handler.interval = args.interval
    server = ThreadingHTTPServer((args.bind, args.port), Handler)
    print(f"latex-preview-server: http://{args.bind}:{args.port}/", flush=True)
    print(f"  serving {ROOT}", flush=True)
    print("  Ctrl-C to stop", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")
    return 0


if __name__ == "__main__":
    sys.exit(main())
